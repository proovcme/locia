# Local URL. For a public server use https://locia.example.org.
APP_URL=http://localhost:8080
LOCIA_WORK_SITE=http://localhost
LOCIA_WORK_HTTP_PORT=8080
LOCIA_WORK_HTTPS_PORT=8443

# Generate separate random values, for example: openssl rand -hex 32
DB_DATABASE=locia
DB_USERNAME=locia
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-another-random-root-password

# First administrator. These values are used only when the database has no admin.
LOCIA_ADMIN_LOGIN=0001
LOCIA_ADMIN_NAME=Администратор
LOCIA_ADMIN_EMAIL=admin@example.org
LOCIA_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Optional encryption key for SMTP credentials: openssl rand -base64 32
APP_DATA_KEY=
APP_TIMEZONE=Europe/Moscow
MAIL_ENABLED=0
