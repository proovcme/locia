{
  "id": "spds_stamp_mvp",
  "name": "СПДС — переоформление штампа",
  "version": "0.0.1",
  "rules": [
    {
      "id": "stamp-surnames",
      "name": "Ответственные по строкам дат",
      "enabled": false,
      "selector": {
        "pages": "all",
        "orientation": "any",
        "document_kind": "any",
        "region": {
          "anchor": "spds_title_block",
          "x_mm": 17,
          "y_mm": 0,
          "width_mm": 55,
          "height_mm": 55
        }
      },
      "match": {
        "type": "date_linked_name",
        "text": "",
        "role": "",
        "years": [2025, 2026]
      },
      "action": {
        "type": "replace",
        "text": "Проектировщик",
        "style": {
          "font_family": "Arial",
          "font_file": "",
          "font_size_pt": 9,
          "min_font_size_pt": 5.5,
          "auto_fit": true,
          "bold": false,
          "italic": false,
          "color": "#000000",
          "background": "#FFFFFF",
          "align": "left",
          "rotation": 0,
          "line_height": 1.05
        }
      }
    },
    {
      "id": "stamp-organization",
      "name": "Организация в основной надписи",
      "enabled": false,
      "selector": {
        "pages": "all",
        "orientation": "any",
        "document_kind": "any",
        "region": {
          "anchor": "spds_title_block",
          "x_mm": 130,
          "y_mm": 40,
          "width_mm": 55,
          "height_mm": 15
        }
      },
      "match": {
        "type": "exact_text",
        "text": "Проектная организация"
      },
      "action": {
        "type": "replace",
        "text": "ООО \"Проектная мастерская\"",
        "target_region": "selector_region",
        "redact_region": "selector_region",
        "style": {
          "font_family": "Arial",
          "font_file": "",
          "font_size_pt": 8,
          "min_font_size_pt": 5,
          "auto_fit": true,
          "bold": false,
          "italic": false,
          "color": "#000000",
          "background": "#FFFFFF",
          "align": "center",
          "rotation": 0,
          "line_height": 1.05
        }
      }
    },
    {
      "id": "note-tch",
      "name": "Красная пометка — ТЧ",
      "enabled": false,
      "selector": {
        "pages": "all",
        "orientation": "portrait",
        "document_kind": "ТЧ",
        "region": {
          "anchor": "detected_title_block_top",
          "x_mm": 25,
          "y_mm": -6.5,
          "width_mm": 120,
          "height_mm": 5.5
        }
      },
      "match": {"type": "none"},
      "action": {
        "type": "add",
        "text": "*В текущий лист изменения не вносились",
        "skip_if_exists": true,
        "style": {
          "font_family": "Arial",
          "font_file": "",
          "font_size_pt": 7.5,
          "min_font_size_pt": 6,
          "auto_fit": true,
          "bold": false,
          "italic": false,
          "color": "#FF0000",
          "background": "#FFFFFF",
          "align": "left",
          "rotation": 0,
          "line_height": 1
        }
      }
    },
    {
      "id": "note-gch",
      "name": "Красная пометка — ГЧ",
      "enabled": false,
      "selector": {
        "pages": "all",
        "orientation": "landscape",
        "document_kind": "ГЧ",
        "region": {
          "anchor": "bottom_left",
          "x_mm": 25,
          "y_mm": 7.5,
          "width_mm": 140,
          "height_mm": 5
        }
      },
      "match": {"type": "none"},
      "action": {
        "type": "add",
        "text": "*В текущий лист изменения не вносились",
        "skip_if_exists": true,
        "style": {
          "font_family": "Arial",
          "font_file": "",
          "font_size_pt": 7,
          "min_font_size_pt": 5,
          "auto_fit": true,
          "bold": false,
          "italic": false,
          "color": "#FF0000",
          "background": "#FFFFFF",
          "align": "left",
          "rotation": 0,
          "line_height": 1
        }
      }
    },
    {
      "id": "document-text",
      "name": "Любой текст в документе",
      "enabled": false,
      "selector": {
        "pages": "all",
        "orientation": "any",
        "document_kind": "any",
        "region": {"anchor": "page", "x_mm": 0, "y_mm": 0, "width_mm": 500, "height_mm": 500}
      },
      "match": {"type": "exact_text", "text": ""},
      "action": {
        "type": "replace",
        "text": "",
        "style": {
          "preserve_source_style": true,
          "font_family": "Arial", "font_file": "", "font_size_pt": 9, "min_font_size_pt": 4,
          "auto_fit": true, "bold": false, "italic": false, "color": "#000000",
          "background": "#FFFFFF", "align": "left", "rotation": 0, "line_height": 1.05
        }
      }
    },
    {
      "id": "document-logo",
      "name": "Логотип",
      "enabled": false,
      "selector": {
        "pages": "all", "orientation": "any", "document_kind": "any",
        "region": {"anchor": "page", "x_mm": 10, "y_mm": 10, "width_mm": 40, "height_mm": 20}
      },
      "match": {"type": "none", "text": ""},
      "action": {
        "type": "add_image", "content_kind": "image", "image_path": "", "text": "",
        "style": {"preserve_source_style": true, "background": "#FFFFFF", "font_family": "Arial", "font_size_pt": 9, "min_font_size_pt": 5, "auto_fit": true, "color": "#000000", "align": "left", "rotation": 0, "line_height": 1}
      }
    }
  ]
}
